<Window x:Class="JiME.ProjectWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:JiME"
        mc:Ignorable="d"
        Title="Your Journey" Height="450" Width="800" Background="{StaticResource bgColor}" WindowStartupLocation="CenterScreen" CanResize="False" WindowDecorations="None" PointerPressed="Window_PointerPressed">

	<Window.Resources>
		<local:BoolToScrollbarVisibilityConverter x:Key="b2sv"/>
		<local:ProjectTypeConverter x:Key="ptypeConverter"/>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="ScrollBar">
			<Setter Property="Background" Value="#333337"/>
		</Style>

		<!--flat project buttons-->
		<Style Selector="Button">
			<Setter Property="Background" Value="#333337"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#4c4c52"/>
			<Setter Property="BorderBrush" Value="#FF0071FF"/>
		</Style>

		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="TextBlock.SubText">
			<Setter Property="Foreground" Value="Silver"/>
		</Style>

		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		</Style>
	</Window.Styles>

	<Grid Margin="30">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width=".5*"/>
			<ColumnDefinition Width=".5*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"/>
			<RowDefinition Height="auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto"/>
		</Grid.RowDefinitions>

		<!--title-->
		<TextBlock FontSize="30" Text="Your Journey"/>
		<TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="14" VerticalAlignment="Center">
			A Scenario Editor For <Italic>Journeys in Middle Earth</Italic>.
		</TextBlock>

		<!--recents-->
		<TextBlock Grid.Row="1" Text="Open Recent File"  Margin="0,10" FontSize="16"/>
		<!--new project-->
		<TextBlock Grid.Row="1" Grid.Column="1" Text="New Project"  Margin="10,10" FontSize="16"/>

		<StackPanel Grid.Row="2" Grid.Column="1">

			<Button x:Name="campaignButton" Click="CampaignButton_Click">
				<Grid Margin="0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Image Grid.RowSpan="2" Source="/Assets/campaign.png" Width="40" Margin="0,0,10,0"/>

					<TextBlock Grid.Column="1" Text="New Campaign" Classes="ButtonHeading" />

					<TextBlock Grid.Column="1" Grid.Row="1" Text="Create a new Campaign that contains multiple linked Scenarios." TextWrapping="Wrap" Classes="SubText" />
				</Grid>
			</Button>

			<Button x:Name="scenarioButton" Margin="0,10" Click="ScenarioButton_Click">
				<Grid Margin="0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Image Grid.RowSpan="2" Source="/Assets/standalone.png" Width="40" Margin="0,0,10,0"/>

					<TextBlock Grid.Column="1" Text="New Standalone Scenario" Classes="ButtonHeading" />

					<TextBlock Grid.Column="1" Grid.Row="1" Text="Create a new Standalone Scenario that is not a part of a Campaign." TextWrapping="Wrap" Classes="SubText"/>
				</Grid>
			</Button>
		</StackPanel>

		<Grid Grid.Column="1" Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock x:Name="formatVersion" Grid.Column="1" Text="Scenario Format Version: " Classes="Heading"/>

			<Button x:Name="cancelButton" Grid.Column="2" Width="100" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Click="CancelButton_Click">
				<TextBlock Classes="ButtonHeading" Text="Cancel" Margin="0,5"/>
			</Button>
		</Grid>

		<ScrollViewer Grid.Row="2" Grid.RowSpan="2" VerticalScrollBarVisibility="{Binding scrollVisible, Converter={StaticResource b2sv}}" Margin="0,0,20,0" PointerEntered="ProjectLV_MouseEnter" PointerExited="ProjectLV_MouseLeave">
			<ListBox x:Name="projectLV" Background="{StaticResource bgColor}" BorderThickness="0" Margin="0,0,10,0" SelectionChanged="ProjectLV_SelectionChanged">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Image Margin="0,5,0,0" VerticalAlignment="Top" Source="{Binding projectType, Converter={StaticResource ptypeConverter}}" Width="32"/>

							<StackPanel Grid.Column="1" Margin="10,0">
								<TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" Margin="0,0"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="{Binding projectType}" Foreground="White" FontSize="12" Margin="0,0"/>
									<StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
										<TextBlock Text="v." Foreground="White"/>
										<TextBlock Grid.Column="1" Text="{Binding fileVersion}" Foreground="White" FontSize="12" Margin="0,0"/>
									</StackPanel>
									<TextBlock Grid.Column="2" Text="{Binding Date}" Classes="SubText" HorizontalAlignment="Right"/>
								</Grid>

								<!--<TextBlock Text="{Binding Description}" TextTrimming="WordEllipsis" Foreground="White" FontSize="12" Margin="0,5,0,0"/>-->
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>
		</ScrollViewer>

	</Grid>
</Window>
