<Window x:Class="JiME.Views.ObjectiveEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:JiME"
        mc:Ignorable="d"
        Title="Objective Editor" Classes="DefaultWindow" WindowStartupLocation="CenterScreen" Width="750" Opened="Window_ContentRendered">

	<Window.Resources>
		<local:BoolInvertConverter x:Key="b2e"/>
		<local:BoolToVisibleConverter x:Key="b2vis"/>
		<local:BoolInvertVisibility x:Key="b2invVis"/>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto"/>
		</Grid.RowDefinitions>

		<StackPanel Margin="5">
			<Border Classes="callout">
				<StackPanel>
					<TextBlock Classes="Heading" Text="This Objective is started when the following Trigger is fired: (Required)"/>
					<StackPanel Orientation="Horizontal">
						<ComboBox x:Name="triggeredByCB" ItemsSource="{Binding scenario.triggersObserver}" SelectedValue="{Binding objective.triggeredByName}" SelectedValueBinding="{Binding dataName}" HorizontalAlignment="Left" VerticalAlignment="Center" DisplayMemberBinding="{Binding dataName}" MinWidth="200"/>

						<Button x:Name="addTriggeredByButton" Background="MediumSeaGreen" Margin="10,0" Height="32" Width="32" Click="addTriggeredByButton_Click">
							<Image Source="/Assets/add2.png"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Classes="callout" Margin="0,10">
				<StackPanel>
					<TextBlock Classes="Heading" Text="Objective Name:"/>
					<TextBlock Classes="SubText">
					A short name used within the Editor. <Bold><Italic>Required</Italic></Bold>
					</TextBlock>
					<TextBox x:Name="nameTB" Classes="DefaultTextBox" Margin="0,5" Width="250" HorizontalAlignment="Left" Text="{Binding shortName, UpdateSourceTrigger=PropertyChanged}"/>

					<TextBlock Classes="Heading" Text="Objective Reminder:" Margin="0,10,0,0"/>
					<TextBlock Classes="SubText">
					This text is shown at all times within the app to describe the current Objective. <Bold><Italic>Required</Italic></Bold>
					</TextBlock>
					<TextBox x:Name="objTB" Classes="DefaultTextBox" Margin="0,5" HorizontalAlignment="Stretch" Text="{Binding objective.objectiveReminder, UpdateSourceTrigger=PropertyChanged}"/>
				</StackPanel>
			</Border>

			<Border Classes="callout">
				<StackPanel>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel>
							<TextBlock Text="Objective Summary" Classes="Heading"/>
							<TextBlock Classes="SubText">
					This text is shown when the Objective begins in order to describe how to complete it. <Bold><Italic>Required</Italic></Bold>
							</TextBlock>
						</StackPanel>

						<Button IsEnabled="{Binding objective.skipSummary, Converter={StaticResource b2e}}" Grid.Column="1" x:Name="editObjectiveButton" Background="CornflowerBlue" Margin="10,0,0,0" Click="EditObjectiveButton_Click" Width="46" Height="46">
							<Image Source="/Assets/edit.png"/>
						</Button>
					</Grid>
					<CheckBox x:Name="skipSummaryCheck" Content="Skip Summary" Foreground="white" VerticalAlignment="Center" IsChecked="{Binding objective.skipSummary, UpdateSourceTrigger=PropertyChanged}"/>
					<TextBlock TextWrapping="Wrap" Text="If Skip Summary is checked, this Objective will begin without showing the Objective Summary text. Use this for multi-part Objectives where a summary isn't needed when going into the next part, and an updated Objective Reminder is enough." Classes="SubText"/>

				</StackPanel>
			</Border>

			<local:GroupBox Header="Objective Completion" FontSize="14" Padding="0" Margin="0,10,0,0">
				<!--<UniformGrid Columns="2">-->
				<StackPanel>
					<Border Classes="callout" Margin="5">
						<StackPanel>
							<StackPanel Orientation="Horizontal">
								<TextBlock Classes="Heading" Margin="0,0,10,5" Text="Lore/ XP / Threat Reduction Rewards:"/>
								<TextBox Classes="DefaultTextBox" Width="25" Text="{Binding objective.loreReward}"/>
								<TextBox Classes="DefaultTextBox" Width="25" Text="{Binding objective.xpReward}" Margin="10,0"/>
								<TextBox Classes="DefaultTextBox" Width="25" Text="{Binding objective.threatReward}"/>
							</StackPanel>

							<UniformGrid Columns="2">
								<StackPanel>
									<TextBlock Classes="Heading" Margin="0,10,0,5" TextWrapping="Wrap">
					This Objective Is Completed When The Following Trigger Is Set: (<Italic>Required</Italic>):
									</TextBlock>
									<StackPanel Orientation="Horizontal">
										<ComboBox x:Name="triggerCB" ItemsSource="{Binding scenario.triggersObserver}" SelectedValue="{Binding objective.triggerName}" SelectedValueBinding="{Binding dataName}" HorizontalAlignment="Left" VerticalAlignment="Center" DisplayMemberBinding="{Binding dataName}" MinWidth="200"/>

										<Button x:Name="addTriggerButton" Background="MediumSeaGreen" Margin="10,0" Height="32" Width="32" Click="AddTriggerButton_Click">
											<Image Source="/Assets/add2.png"/>
										</Button>
									</StackPanel>
								</StackPanel>

								<StackPanel>
									<TextBlock Classes="Heading" Margin="0,10,0,5" TextWrapping="Wrap">
					Set This Trigger When The Objective Is Completed: (<Italic>Optional</Italic>):
									</TextBlock>
									<StackPanel Orientation="Horizontal">
										<ComboBox x:Name="nextTriggerCB" ItemsSource="{Binding scenario.triggersObserver}" HorizontalAlignment="Left" VerticalAlignment="Center" DisplayMemberBinding="{Binding dataName}" MinWidth="250" SelectedValueBinding="{Binding dataName}" SelectedValue="{Binding objective.nextTrigger}"/>
										<Button x:Name="addTriggerButton2" Background="MediumSeaGreen" Margin="10,0" Height="32" Width="32" Click="addTriggerButton2_Click">
											<Image Source="/Assets/add2.png"/>
										</Button>
									</StackPanel>
								</StackPanel>
							</UniformGrid>
						</StackPanel>
					</Border>
				</StackPanel>
			</local:GroupBox>
		</StackPanel>

		<!--Footer-->
		<Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Silver" HorizontalAlignment="Stretch" Background="#FF46464A">
			<WrapPanel HorizontalAlignment="Right" >

				<Button x:Name="okButton" Margin="10" Background="MediumSeaGreen" Click="OkButton_Click" IsDefault="True">
					<Image Source="/Assets/ok.png" Stretch="Uniform" Width="32" Margin="5"/>
				</Button>

				<Button x:Name="cancelButton" Margin="0,10,10,10" Background="{StaticResource bgCancelDelete}" Click="CancelButton_Click" IsCancel="True">
					<Image Source="/Assets/cancel.png" Stretch="Uniform" Width="32" Margin="5"/>
				</Button>
			</WrapPanel>
		</Border>
	</Grid>

</Window>
