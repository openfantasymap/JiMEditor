<Project Sdk="Microsoft.NET.Sdk">

	<!-- UI-free scenario model, JSON file format and project folder handling, shared by the editor and its tests -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>JiME</RootNamespace>
		<AssemblyName>JiME.Core</AssemblyName>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\*.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
